{
  "expo": {
    "name": "TandaIU",
    "slug": "presensi-praktikum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "presensipraktikum",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nabilakaylarafa.presensipraktikum"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TandaIU menggunakan lokasi perangkat hanya untuk memvalidasi presensi di laboratorium."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "TandaIU menggunakan kamera untuk memindai QR presensi praktikum.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6F8"
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c762a8c6-d2ac-431c-9108-28f4a2547697"
      }
    }
  }
}
