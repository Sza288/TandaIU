rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Memeriksa apakah pengguna sudah login.
    function isSignedIn() {
      return request.auth != null;
    }

    // Mengambil role dari dokumen users/{uid}, bukan dari custom token.
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Asisten adalah pengguna login dengan role 'asisten'.
    function isAssistant() {
      return isSignedIn() && userRole() == 'asisten';
    }

    // Pengguna hanya boleh membaca dokumennya sendiri.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      // Pembuatan hanya oleh pemilik, role valid, uid cocok, dan field wajib lengkap.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['asisten', 'praktikan']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'role']);
      // Update hanya oleh pemilik dan field role tidak boleh berubah.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      // Penghapusan dokumen pengguna ditolak.
      allow delete: if false;
    }

    // Semua pengguna terautentikasi boleh membaca kelas; hanya asisten yang boleh menulis.
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAssistant();
    }

    // Semua pengguna terautentikasi boleh membaca jadwal; hanya asisten yang boleh menulis.
    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isAssistant();
    }

    // Semua pengguna terautentikasi boleh membaca sesi; hanya asisten yang boleh menulis.
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isAssistant();
    }

    // Presensi: ID = sessionId + '_' + uid, hanya praktikan untuk dirinya saat sesi dibuka.
    match /attendances/{attendanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && userRole() == 'praktikan'
        && request.resource.data.praktikanId == request.auth.uid
        && attendanceId == request.resource.data.sessionId + '_' + request.auth.uid
        && request.resource.data.status == 'hadir'
        && request.resource.data.keys().hasAll(['sessionId', 'praktikanId', 'praktikanName', 'attendedAt', 'status'])
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'dibuka';
      allow update, delete: if false;
    }

    // Izin: praktikan mengajukan 'pending', asisten mereview jadi 'approved'/'rejected'.
    match /permits/{permitId} {
      allow read: if isSignedIn()
        && (resource.data.studentId == request.auth.uid || isAssistant());
      allow create: if isSignedIn()
        && userRole() == 'praktikan'
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['reviewedAt', 'reviewedBy'])
        && request.resource.data.keys().hasAll(['sessionId', 'studentId', 'studentName', 'reason', 'status', 'createdAt']);
      allow update: if isAssistant()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy']);
      allow delete: if false;
    }

    // Koleksi lain ditolak secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
