
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasValidProfile(uid) {
      return exists(userPath(uid))
        && get(userPath(uid)).data.role in ['praktikan', 'asisten', 'assistant']
        && get(userPath(uid)).data.name is string
        && get(userPath(uid)).data.email is string;
    }

    function userRole() {
      return get(userPath(request.auth.uid)).data.role;
    }

    function isPraktikan() {
      return isSignedIn()
        && validPraktikanProfile(get(userPath(request.auth.uid)).data);
    }

    function validPraktikanProfile(data) {
      return data.role == 'praktikan'
        && data.name is string
        && data.email is string;
    }

    // The role comes from the trusted profile; semester ownership comes only
    // from an Admin SDK custom claim.
    function isAssistant() {
      return isSignedIn()
        && validAssistantProfile(get(userPath(request.auth.uid)).data)
        && request.auth.token.assistantSemesterParity in ['ganjil', 'genap'];
    }

    function validAssistantProfile(data) {
      return data.role in ['asisten', 'assistant']
        && data.name is string
        && data.email is string;
    }

    function semesterMatchesAssignment(semester) {
      return semester is int
        && semester > 0
        && ((semester % 2 == 1 && request.auth.token.assistantSemesterParity == 'ganjil')
          || (semester % 2 == 0 && request.auth.token.assistantSemesterParity == 'genap'));
    }

    function courseMatchesSemester(courseId, semester, parity) {
      return courseId is string
        && semester is int
        && semester > 0
        && parity in ['ganjil', 'genap']
        && courseCatalogEntryMatches(courseId, semester, parity);
    }

    function courseCatalogEntryMatches(courseId, semester, parity) {
      let coursePath = /databases/$(database)/documents/courseCatalog/$(courseId);
      return courseCatalogEntryMatchesData(get(coursePath).data, semester, parity);
    }

    function courseCatalogEntryMatchesData(course, semester, parity) {
      return course.semester == semester
        && course.semesterParity == parity
        && parity == (semester % 2 == 1 ? 'ganjil' : 'genap');
    }

    function validClass(data) {
      return data.keys().hasAll([
          'courseId', 'className', 'createdAt', 'semester', 'semesterParity', 'assistantUid'
        ])
        && data.keys().hasOnly([
          'courseId', 'className', 'createdAt', 'semester', 'semesterParity', 'assistantUid'
        ])
        && data.courseId is string
        && data.className is string
        && data.createdAt is string
        && data.assistantUid is string
        && courseMatchesSemester(data.courseId, data.semester, data.semesterParity);
    }

    function assistantOwnsClass(classId) {
      return isAssistant()
        && assistantOwnsClassData(
          get(/databases/$(database)/documents/classes/$(classId)).data
        );
    }

    function assistantOwnsClassData(data) {
      return data.assistantUid == request.auth.uid
        && data.semesterParity == request.auth.token.assistantSemesterParity
        && semesterMatchesAssignment(data.semester)
        && courseMatchesSemester(data.courseId, data.semester, data.semesterParity);
    }

    function praktikanEnrolledInClass(classId) {
      return isPraktikan()
        && exists(/databases/$(database)/documents/enrollments/$(classId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/enrollments/$(classId + '_' + request.auth.uid)).data.praktikanId == request.auth.uid
        && get(/databases/$(database)/documents/enrollments/$(classId + '_' + request.auth.uid)).data.classId == classId;
    }

    function sessionMatchesClass(data) {
      return data.classId is string
        && sessionMatchesClassById(data, data.classId);
    }

    function sessionMatchesClassById(data, classId) {
      let classPath = /databases/$(database)/documents/classes/$(classId);
      return sessionMatchesClassData(data, get(classPath).data);
    }

    function sessionMatchesClassData(data, classData) {
      return validClass(classData)
        && data.courseId == classData.courseId
        && data.className == classData.className
        && data.semester == classData.semester
        && data.semesterParity == classData.semesterParity
        && data.assistantUid == classData.assistantUid;
    }

    function validSessionTimePair(data) {
      return (data.startsAt is timestamp
          && data.endsAt is timestamp
          && data.endsAt > data.startsAt)
        || (data.startsAt is string && data.endsAt is string);
    }

    function validSessionOptionalRefs(data) {
      return ((!data.keys().hasAny(['lecturerId', 'lecturer']))
          || (data.lecturerId is string && data.lecturer is string))
        && ((!data.keys().hasAny(['laboratoryId']))
          || (data.laboratoryId is string
            && exists(/databases/$(database)/documents/laboratories/$(data.laboratoryId))))
        && ((!data.keys().hasAny(['scheduleId']))
          || (data.scheduleId is string
            && exists(/databases/$(database)/documents/schedules/$(data.scheduleId))));
    }

    function validSessionForReference(data) {
      return data.keys().hasAll([
          'classId', 'courseId', 'practicumName', 'className', 'startsAt', 'endsAt',
          'status', 'semester', 'semesterParity', 'assistantUid'
        ])
        && data.keys().hasOnly([
          'classId', 'courseId', 'practicumName', 'className', 'startsAt', 'endsAt',
          'status', 'semester', 'semesterParity', 'assistantUid', 'lecturerId', 'lecturer',
          'laboratoryId', 'scheduleId'
        ])
        && data.practicumName is string
        && validSessionTimePair(data)
        && data.status in ['terjadwal', 'dibuka', 'ditutup']
        && ((!data.keys().hasAny(['lecturerId', 'lecturer']))
          || (data.lecturerId is string && data.lecturer is string))
        && ((!data.keys().hasAny(['laboratoryId'])) || data.laboratoryId is string)
        && ((!data.keys().hasAny(['scheduleId'])) || data.scheduleId is string)
        && sessionMatchesClass(data);
    }

    function validSession(data) {
      return validSessionForReference(data)
        && validSessionOptionalRefs(data);
    }

    function validLaboratory(data) {
      return data.keys().hasAll([
          'name', 'latitude', 'longitude', 'radius', 'lantai', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'latitude', 'longitude', 'radius', 'lantai', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && (data.latitude is float || data.latitude is int)
        && data.latitude >= -90
        && data.latitude <= 90
        && (data.longitude is float || data.longitude is int)
        && data.longitude >= -180
        && data.longitude <= 180
        && data.radius is int
        && data.radius >= 1
        && data.radius <= 500
        && data.lantai is int
        && data.lantai >= 1
        && data.lantai <= 6
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function assistantOwnsSession(sessionId) {
      let sessionPath = /databases/$(database)/documents/sessions/$(sessionId);
      return isAssistant()
        && assistantOwnsSessionData(get(sessionPath).data);
    }

    function assistantOwnsSessionData(session) {
      return validSession(session)
        && session.assistantUid == request.auth.uid
        && session.semesterParity == request.auth.token.assistantSemesterParity
        && assistantOwnsClass(session.classId);
    }

    function sessionRecordInAssistantScope(data) {
      return isAssistant()
        && validSession(data)
        && data.assistantUid == request.auth.uid
        && exists(/databases/$(database)/documents/classes/$(data.classId))
        && get(/databases/$(database)/documents/classes/$(data.classId)).data.assistantUid == request.auth.uid
        && get(/databases/$(database)/documents/classes/$(data.classId)).data.semesterParity == request.auth.token.assistantSemesterParity
        && semesterMatchesAssignment(data.semester);
    }

    function validScheduledSessionClientUpdate(existing, incoming) {
      return existing.status == 'terjadwal'
        && incoming.status == 'terjadwal'
        && incoming.startsAt is timestamp
        && incoming.endsAt is timestamp
        && incoming.endsAt > incoming.startsAt
        && validSessionOptionalRefs(incoming)
        && incoming.classId == existing.classId
        && incoming.courseId == existing.courseId
        && incoming.practicumName == existing.practicumName
        && incoming.className == existing.className
        && incoming.semester == existing.semester
        && incoming.semesterParity == existing.semesterParity
        && incoming.assistantUid == existing.assistantUid
        && (!existing.keys().hasAny(['lecturerId'])
          || incoming.lecturerId == existing.lecturerId)
        && (!existing.keys().hasAny(['lecturer'])
          || incoming.lecturer == existing.lecturer)
        && (!existing.keys().hasAny(['scheduleId'])
          || incoming.scheduleId == existing.scheduleId)
        && incoming.diff(existing).affectedKeys().hasOnly([
          'startsAt', 'endsAt', 'laboratoryId', 'lecturerId', 'lecturer', 'scheduleId'
        ]);
    }

    function validSessionStatusTransition(existing, incoming) {
      return incoming.diff(existing).affectedKeys().hasOnly(['status'])
        && ((existing.status == 'terjadwal'
            && incoming.status == 'dibuka'
            && existing.startsAt is timestamp
            && existing.endsAt is timestamp
            && existing.endsAt > existing.startsAt
            && existing.endsAt > request.time)
          || (existing.status == 'dibuka' && incoming.status == 'ditutup'));
    }

    function attendanceEnrollmentExists(classId, courseId, semester) {
      let enrollmentId = classId + '_' + request.auth.uid;
      let enrollmentPath = /databases/$(database)/documents/enrollments/$(enrollmentId);
      return attendanceEnrollmentMatches(get(enrollmentPath).data, classId, courseId, semester);
    }

    function attendanceEnrollmentMatches(data, classId, courseId, semester) {
      return data.praktikanId == request.auth.uid
        && data.classId == classId
        && data.courseId == courseId
        && data.semester == semester;
    }

    function attendanceQrMatches(sessionId, token) {
      let tokenPath = /databases/$(database)/documents/attendanceQrTokens/$(sessionId);
      return token is string
        && attendanceQrTokenMatches(get(tokenPath).data, sessionId, token);
    }

    function attendanceQrTokenMatches(data, sessionId, token) {
      return data.sessionId == sessionId
        && data.token == token
        && data.revokedAt == null
        && data.expiresAt is timestamp
        && data.expiresAt > request.time;
    }

    function validAttendanceCreate(data, attendanceId) {
      let laboratoryPath = /databases/$(database)/documents/laboratories/$(data.laboratoryId);
      let sessionPath = /databases/$(database)/documents/sessions/$(data.sessionId);
      return data.keys().hasAll([
          'sessionId', 'praktikanId', 'praktikanName', 'attendedAt', 'status',
          'attendanceMethod', 'latitude', 'longitude', 'accuracyMeters', 'distanceMeters',
          'laboratoryId', 'laboratoryName', 'radiusMeters'
        ])
        && data.keys().hasOnly([
          'sessionId', 'praktikanId', 'praktikanName', 'attendedAt', 'status',
          'attendanceMethod', 'latitude', 'longitude', 'accuracyMeters', 'distanceMeters',
          'laboratoryId', 'laboratoryName', 'radiusMeters', 'qrToken'
        ])
        && data.sessionId is string
        && attendanceId == data.sessionId + '_' + request.auth.uid
        && attendanceProfileMatches(data)
        && data.attendedAt == request.time
        && data.status == 'hadir'
        && data.attendanceMethod in ['location', 'qr']
        && (data.latitude is float || data.latitude is int)
        && data.latitude >= -90
        && data.latitude <= 90
        && (data.longitude is float || data.longitude is int)
        && data.longitude >= -180
        && data.longitude <= 180
        && (data.accuracyMeters is float || data.accuracyMeters is int)
        && data.accuracyMeters >= 0
        && data.accuracyMeters <= 50
        && (data.distanceMeters is float || data.distanceMeters is int)
        && data.distanceMeters >= 0
        && data.radiusMeters is int
        && data.radiusMeters >= 1
        && data.radiusMeters <= 500
        && data.laboratoryId is string
        && validAttendanceReferences(data, get(laboratoryPath).data, get(sessionPath).data)
    }

    function attendanceProfileMatches(data) {
      return isSignedIn()
        && attendanceProfileDataMatches(
          get(userPath(request.auth.uid)).data,
          data,
          request.auth.uid
        );
    }

    function attendanceProfileDataMatches(profile, data, uid) {
      return profile.role == 'praktikan'
        && profile.name is string
        && profile.email is string
        && data.praktikanId == uid
        && data.praktikanName == profile.name;
    }

    function validAttendanceReferences(data, laboratory, session) {
      return validLaboratory(laboratory)
        && data.laboratoryName == laboratory.name
        && data.radiusMeters == laboratory.radius
        && validSessionForReference(session)
        && session.status == 'dibuka'
        && session.startsAt is timestamp
        && session.endsAt is timestamp
        && session.startsAt <= request.time
        && session.endsAt > request.time
        && attendanceEnrollmentExists(session.classId, session.courseId, session.semester)
        && session.laboratoryId == data.laboratoryId
        && ((data.attendanceMethod == 'location' && !data.keys().hasAny(['qrToken']))
          || (data.attendanceMethod == 'qr'
            && data.keys().hasAny(['qrToken'])
            && attendanceQrMatches(data.sessionId, data.qrToken)));
    }

    function validAttendanceCancellation(existing, incoming) {
      return assistantOwnsSession(existing.sessionId)
        && existing.status == 'hadir'
        && incoming.status == 'dibatalkan'
        && incoming.sessionId == existing.sessionId
        && incoming.praktikanId == existing.praktikanId
        && incoming.praktikanName == existing.praktikanName
        && incoming.attendedAt == existing.attendedAt
        && incoming.cancelledAt == request.time
        && incoming.cancelledBy == request.auth.uid
        && (incoming.cancelReason == null
          || (incoming.cancelReason is string && incoming.cancelReason.size() <= 300))
        && incoming.diff(existing).affectedKeys().hasOnly([
          'status', 'cancelledAt', 'cancelledBy', 'cancelReason'
        ]);
    }

    function validAttendanceQr(data, sessionId) {
      return data.keys().hasAll([
          'sessionId', 'token', 'issuedBy', 'issuedAt', 'expiresAt', 'revokedAt', 'revokedBy'
        ])
        && data.keys().hasOnly([
          'sessionId', 'token', 'issuedBy', 'issuedAt', 'expiresAt', 'revokedAt', 'revokedBy'
        ])
        && data.sessionId == sessionId
        && data.token is string
        && data.token.matches('^[A-Za-z0-9_-]{43}$')
        && data.issuedBy == request.auth.uid
        && data.issuedAt == request.time
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(2, 'm')
        && data.revokedAt == null
        && data.revokedBy == null;
    }

    function validAttendanceQrRevocation(existing, incoming, sessionId) {
      return assistantOwnsSession(sessionId)
        && existing.sessionId == sessionId
        && existing.revokedAt == null
        && incoming.sessionId == existing.sessionId
        && incoming.token == existing.token
        && incoming.issuedBy == existing.issuedBy
        && incoming.issuedAt == existing.issuedAt
        && incoming.expiresAt == existing.expiresAt
        && incoming.revokedAt == request.time
        && incoming.revokedBy == request.auth.uid
        && incoming.diff(existing).affectedKeys().hasOnly(['revokedAt', 'revokedBy']);
    }

    function validAttendanceQrIssue(sessionId, data) {
      let sessionPath = /databases/$(database)/documents/sessions/$(sessionId);
      let session = get(sessionPath).data;
      return isAssistant()
        && session.status == 'dibuka'
        && assistantOwnsSessionData(session)
        && validAttendanceQr(data, sessionId);
    }

    function scheduleRecordInAssistantScope(data) {
      return isAssistant()
        && data.keys().hasAll([
          'classId', 'courseId', 'dayOfWeek', 'startTime', 'endTime', 'room',
          'semesterParity', 'assistantUid'
        ])
        && data.keys().hasOnly([
          'classId', 'courseId', 'dayOfWeek', 'startTime', 'endTime', 'room',
          'semesterParity', 'assistantUid', 'jumlahPertemuan'
        ])
        && data.classId is string
        && data.courseId is string
        && data.dayOfWeek is int
        && data.dayOfWeek >= 0
        && data.dayOfWeek <= 6
        && data.startTime is string
        && data.endTime is string
        && data.room is string
        && ((!data.keys().hasAny(['jumlahPertemuan']))
          || (data.jumlahPertemuan is int
            && data.jumlahPertemuan >= 1
            && data.jumlahPertemuan <= 20))
        && data.assistantUid == request.auth.uid
        && exists(/databases/$(database)/documents/classes/$(data.classId))
        && get(/databases/$(database)/documents/classes/$(data.classId)).data.assistantUid == request.auth.uid
        && get(/databases/$(database)/documents/classes/$(data.classId)).data.semester is int
        && semesterMatchesAssignment(get(/databases/$(database)/documents/classes/$(data.classId)).data.semester)
        && data.courseId == get(/databases/$(database)/documents/classes/$(data.classId)).data.courseId
        && data.semesterParity == get(/databases/$(database)/documents/classes/$(data.classId)).data.semesterParity
        && courseMatchesSemester(
          get(/databases/$(database)/documents/classes/$(data.classId)).data.courseId,
          get(/databases/$(database)/documents/classes/$(data.classId)).data.semester,
          get(/databases/$(database)/documents/classes/$(data.classId)).data.semesterParity
        );
    }

    function validEnrollment(data, enrollmentId) {
      return data.keys().hasAll([
          'praktikanId', 'praktikanName', 'studentCode', 'classId', 'courseId', 'semester', 'createdAt'
        ])
        && data.keys().hasOnly([
          'praktikanId', 'praktikanName', 'studentCode', 'classId', 'courseId', 'semester', 'createdAt'
        ])
        && data.praktikanId is string
        && data.praktikanName is string
        && data.studentCode is string
        && data.classId is string
        && data.courseId is string
        && data.semester is int
        && data.createdAt is string
        && enrollmentId == data.classId + '_' + data.praktikanId;
    }

    function validDirectory(data) {
      return data.keys().hasAll(['name', 'studentCode', 'semester', 'semesterParity'])
        && data.keys().hasOnly(['name', 'studentCode', 'semester', 'semesterParity'])
        && data.name is string
        && data.studentCode is string
        && data.semester is int
        && data.semester > 0
        && data.semesterParity in ['ganjil', 'genap']
        && data.semesterParity == (data.semester % 2 == 1 ? 'ganjil' : 'genap');
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'praktikan'
        && request.resource.data.authProvider in ['google', 'password']
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.keys().hasAll(['uid', 'role', 'authProvider', 'email', 'name'])
        && request.resource.data.keys().hasOnly(['uid', 'role', 'authProvider', 'email', 'name', 'studentCode'])
        && (!request.resource.data.keys().hasAny(['studentCode']) || request.resource.data.studentCode is string);
      allow update, delete: if false;
    }

    match /courseCatalog/{courseId} {
      allow read, write: if false;
    }

    match /studentDirectory/{praktikanId} {
      allow get: if (isPraktikan()
          && request.auth.uid == praktikanId
          && validDirectory(resource.data))
        || (isAssistant()
          && validDirectory(resource.data)
          && semesterMatchesAssignment(resource.data.semester)
          && resource.data.semesterParity == request.auth.token.assistantSemesterParity);
      allow list: if isAssistant()
        && resource.data.semesterParity == request.auth.token.assistantSemesterParity;
      allow create, update, delete: if false;
    }

    match /classes/{classId} {
      allow get: if (isAssistant()
          && validClass(resource.data)
          && resource.data.assistantUid == request.auth.uid
          && resource.data.semesterParity == request.auth.token.assistantSemesterParity)
        || (praktikanEnrolledInClass(classId) && validClass(resource.data));
      allow list: if (isAssistant()
          && resource.data.assistantUid == request.auth.uid
          && resource.data.semesterParity == request.auth.token.assistantSemesterParity)
        || praktikanEnrolledInClass(classId);
      allow create: if validClass(request.resource.data)
        && isAssistant()
        && request.resource.data.assistantUid == request.auth.uid
        && semesterMatchesAssignment(request.resource.data.semester);
      allow update: if assistantOwnsClass(classId)
        && validClass(request.resource.data)
        && request.resource.data.assistantUid == resource.data.assistantUid
        && request.resource.data.semester == resource.data.semester
        && request.resource.data.semesterParity == resource.data.semesterParity
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /schedules/{scheduleId} {
      allow get: if (isPraktikan()
          && resource.data.classId is string
          && praktikanEnrolledInClass(resource.data.classId))
        || (isAssistant()
          && scheduleRecordInAssistantScope(resource.data)
          && resource.data.semesterParity == request.auth.token.assistantSemesterParity);
      allow list: if (isPraktikan()
          && resource.data.classId is string
          && praktikanEnrolledInClass(resource.data.classId))
        || (isAssistant()
          && resource.data.assistantUid == request.auth.uid
          && resource.data.semesterParity == request.auth.token.assistantSemesterParity);
      allow create: if scheduleRecordInAssistantScope(request.resource.data);
      allow update: if scheduleRecordInAssistantScope(resource.data)
        && scheduleRecordInAssistantScope(request.resource.data);
      allow delete: if scheduleRecordInAssistantScope(resource.data);
    }

    match /sessions/{sessionId} {
      allow get: if (isPraktikan()
          && validSession(resource.data)
          && praktikanEnrolledInClass(resource.data.classId))
        || (isAssistant()
          && validSession(resource.data)
          && resource.data.assistantUid == request.auth.uid
          && resource.data.semesterParity == request.auth.token.assistantSemesterParity);
      allow list: if (isPraktikan()
          && resource.data.classId is string
          && praktikanEnrolledInClass(resource.data.classId))
        || (isAssistant()
          && resource.data.assistantUid == request.auth.uid
          && resource.data.semesterParity == request.auth.token.assistantSemesterParity);
      allow create: if sessionRecordInAssistantScope(request.resource.data)
        && request.resource.data.status == 'terjadwal'
        && request.resource.data.startsAt is timestamp
        && request.resource.data.endsAt is timestamp;
      allow update: if sessionRecordInAssistantScope(resource.data)
        && (validScheduledSessionClientUpdate(resource.data, request.resource.data)
          || validSessionStatusTransition(resource.data, request.resource.data));
      allow delete: if false;
    }

    match /laboratories/{laboratoryId} {
      allow get, list: if isSignedIn();
      allow create: if isAssistant() && validLaboratory(request.resource.data);
      allow update: if isAssistant()
        && validLaboratory(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAssistant();
    }

    match /enrollments/{enrollmentId} {
      allow get: if (isPraktikan() && resource == null)
        || (isPraktikan()
          && resource.data.praktikanId == request.auth.uid
          && enrollmentId == resource.data.classId + '_' + request.auth.uid)
        || (isAssistant()
          && validEnrollment(resource.data, enrollmentId)
          && assistantOwnsClass(resource.data.classId));
      allow list: if (isPraktikan()
          && resource.data.keys().hasAll(['praktikanId'])
          && resource.data.praktikanId == request.auth.uid)
        || (isAssistant()
          && resource.data.keys().hasAll(['classId'])
          && resource.data.classId is string
          && assistantOwnsClass(resource.data.classId));
      allow create: if isAssistant()
        && validEnrollment(request.resource.data, enrollmentId)
        && assistantOwnsClass(request.resource.data.classId)
        && request.resource.data.courseId == get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.courseId
        && request.resource.data.semester == get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.semester
        && exists(/databases/$(database)/documents/studentDirectory/$(request.resource.data.praktikanId))
        && validDirectory(get(/databases/$(database)/documents/studentDirectory/$(request.resource.data.praktikanId)).data)
        && get(/databases/$(database)/documents/studentDirectory/$(request.resource.data.praktikanId)).data.semester == request.resource.data.semester
        && get(/databases/$(database)/documents/studentDirectory/$(request.resource.data.praktikanId)).data.semesterParity == get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.semesterParity
        && get(/databases/$(database)/documents/studentDirectory/$(request.resource.data.praktikanId)).data.studentCode == request.resource.data.studentCode
        && get(/databases/$(database)/documents/studentDirectory/$(request.resource.data.praktikanId)).data.name == request.resource.data.praktikanName
        && exists(userPath(request.resource.data.praktikanId))
        && get(userPath(request.resource.data.praktikanId)).data.role == 'praktikan';
      allow delete: if isAssistant()
        && validEnrollment(resource.data, enrollmentId)
        && assistantOwnsClass(resource.data.classId);
      allow update: if false;
    }

    match /attendances/{attendanceId} {
      allow get: if (isPraktikan() && resource == null)
        || (isPraktikan()
          && resource.data.praktikanId == request.auth.uid
          && attendanceId == resource.data.sessionId + '_' + request.auth.uid)
        || assistantOwnsSession(resource.data.sessionId);
      allow list: if (isPraktikan() && resource.data.praktikanId == request.auth.uid)
        || assistantOwnsSession(resource.data.sessionId);
      allow create: if validAttendanceCreate(request.resource.data, attendanceId);
      allow update: if validAttendanceCancellation(resource.data, request.resource.data);
      allow delete: if false;
    }

    match /permits/{permitId} {
      allow get: if (isPraktikan() && resource == null)
        || (isPraktikan() && resource.data.studentId == request.auth.uid)
        || assistantOwnsSession(resource.data.sessionId);
      allow list: if (isPraktikan() && resource.data.studentId == request.auth.uid)
        || assistantOwnsSession(resource.data.sessionId);
      allow create: if isPraktikan()
        && request.resource.data.keys().hasAll([
          'sessionId', 'studentId', 'studentName', 'reason', 'sentiment', 'sentimentSource',
          'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'sessionId', 'studentId', 'studentName', 'reason', 'sentiment', 'sentimentSource',
          'status', 'createdAt'
        ])
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.studentName == get(userPath(request.auth.uid)).data.name
        && request.resource.data.reason is string
        && request.resource.data.sentiment in ['positif', 'netral', 'negatif']
        && request.resource.data.sentimentSource in ['model', 'fallback']
        && permitId == request.resource.data.sessionId + '_' + request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is string
        && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
        && validSessionForReference(get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data)
        && praktikanEnrolledInClass(get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.classId);
      allow update: if assistantOwnsSession(resource.data.sessionId)
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedAt is string
        && (!request.resource.data.keys().hasAny(['reviewedBy'])
          || request.resource.data.reviewedBy == get(userPath(request.auth.uid)).data.name)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy']);
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow get: if (isPraktikan() && resource == null)
        || (isPraktikan() && resource.data.studentId == request.auth.uid)
        || assistantOwnsSession(resource.data.sessionId);
      allow list: if (isPraktikan() && resource.data.studentId == request.auth.uid)
        || assistantOwnsSession(resource.data.sessionId);
      allow create: if isPraktikan()
        && request.resource.data.keys().hasAll([
          'sessionId', 'studentId', 'studentName', 'comment', 'sentiment', 'sentimentSource', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'sessionId', 'studentId', 'studentName', 'comment', 'sentiment', 'sentimentSource', 'createdAt'
        ])
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.studentName == get(userPath(request.auth.uid)).data.name
        && request.resource.data.comment is string
        && request.resource.data.sentiment in ['positif', 'netral', 'negatif']
        && request.resource.data.sentimentSource in ['model', 'fallback']
        && request.resource.data.createdAt is string
        && reviewId == request.resource.data.sessionId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
        && validSessionForReference(get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data)
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'ditutup'
        && praktikanEnrolledInClass(get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.classId);
      allow update, delete: if false;
    }

    match /attendanceArchieve/{archiveId} {
      allow get, list: if isPraktikan()
        && resource.data.keys().hasAll(['praktikanId'])
        && resource.data.praktikanId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /attendanceQrTokens/{sessionId} {
      allow get: if (isPraktikan()
          && praktikanCanReadAttendanceQr(sessionId))
        || assistantOwnsSession(sessionId);
      allow list: if false;
      allow create: if validAttendanceQrIssue(sessionId, request.resource.data);
      allow update: if validAttendanceQrRevocation(resource.data, request.resource.data, sessionId)
        || validAttendanceQrIssue(sessionId, request.resource.data);
      allow delete: if false;
    }

    function praktikanCanReadAttendanceQr(sessionId) {
      let sessionPath = /databases/$(database)/documents/sessions/$(sessionId);
      return praktikanCanReadAttendanceQrData(get(sessionPath).data);
    }

    function praktikanCanReadAttendanceQrData(session) {
      return validSession(session)
        && session.status == 'dibuka'
        && attendanceEnrollmentExists(session.classId, session.courseId, session.semester);
    }

    // Deny every collection that has no explicit policy above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
