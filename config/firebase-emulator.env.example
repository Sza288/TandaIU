# Copy this file to .env.development.local (already ignored by the project).
# Replace the host with the laptop's current Wi-Fi IPv4 address.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-tandaiu-rules.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-tandaiu-rules
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-tandaiu-rules.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:local-emulator

# Local-only shared password for the emulator accounts; never use in production.
TANDAIU_EMULATOR_DUMMY_PASSWORD=CHANGE_ME_LOCAL_TEST_PASSWORD
